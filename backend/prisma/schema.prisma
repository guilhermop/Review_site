generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  reviews   Review[]
}

enum MediaType {
  BOOK
  GAME
  MOVIE
}

model Media {
  id         Int        @id @default(autoincrement())
  type       MediaType
  title      String
  creator    String?
  year       Int?
  attributes Json?
  createdAt  DateTime   @default(now())

  reviews    Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  mediaId   Int
  media     Media    @relation(fields: [mediaId], references: [id])
}